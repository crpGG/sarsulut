rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'crpmovie@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isMasterAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Optional-field helper: absent is fine, present must be a bounded string.
    function optStr(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // Images are stored in Firebase Storage and referenced here by download URL.
    // The cap keeps base64 data URLs out of Firestore documents, which would
    // otherwise blow past the 1 MiB per-document limit.
    function isImageRef(data) {
      return optStr(data, 'image', 5000);
    }

    // Validation Functions
    // These mirror the interfaces in src/types.ts. Keep the two in sync:
    // a field name that drifts here silently turns every write into
    // permission-denied.
    function isValidNews(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.category is string && data.category.size() <= 60
        && data.date is string && data.date.size() <= 60
        && optStr(data, 'author', 100)
        && optStr(data, 'location', 150)
        && optStr(data, 'summary', 600)
        && optStr(data, 'content', 15000)
        && isImageRef(data)
        && (!('status' in data) || data.status in ['published', 'draft'])
        && (!('pinned' in data) || data.pinned is bool)
        && (!('views' in data) || data.views is int)
        && (!('tags' in data) || data.tags is list);
    }

    function isValidGallery(data) {
      return data.label is string && data.label.size() > 0 && data.label.size() <= 200
        && data.aspect in ['r1610', 'r11']
        && optStr(data, 'caption', 500)
        && optStr(data, 'category', 60)
        && optStr(data, 'location', 150)
        && optStr(data, 'date', 60)
        && optStr(data, 'colSpan', 40)
        && isImageRef(data);
    }

    function isValidActivity(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.type is string && data.type.size() <= 60
        && data.date is string && data.date.size() <= 60
        && data.location is string && data.location.size() <= 150
        && data.status in ['selesai', 'berlangsung', 'dijadwalkan']
        && optStr(data, 'desc', 2000)
        && optStr(data, 'participants', 200)
        && isImageRef(data);
    }

    function isValidContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 3000
        && optStr(data, 'email', 120)
        && optStr(data, 'phone', 40)
        && optStr(data, 'subject', 200)
        && optStr(data, 'category', 60);
    }

    // Collections

    // 1. News Articles
    match /news/{newsId} {
      allow get: if isValidId(newsId);
      allow list: if true;
      allow create: if isValidId(newsId) && isAdmin() && isValidNews(incoming());
      allow update: if isValidId(newsId) && isAdmin() && isValidNews(incoming());
      allow delete: if isValidId(newsId) && isAdmin();
    }

    // 2. Photo Galleries
    match /galleries/{galleryId} {
      allow get: if isValidId(galleryId);
      allow list: if true;
      allow create: if isValidId(galleryId) && isAdmin() && isValidGallery(incoming());
      allow update: if isValidId(galleryId) && isAdmin() && isValidGallery(incoming());
      allow delete: if isValidId(galleryId) && isAdmin();
    }

    // 3. SAR Activities & Exercises
    match /activities/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if true;
      allow create: if isValidId(activityId) && isAdmin() && isValidActivity(incoming());
      allow update: if isValidId(activityId) && isAdmin() && isValidActivity(incoming());
      allow delete: if isValidId(activityId) && isAdmin();
    }

    // 4. Contact & PPID Submissions
    match /contacts/{contactId} {
      allow create: if isValidId(contactId) && isValidContact(incoming());
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // 5. Admins
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isMasterAdmin());
      allow write: if isMasterAdmin();
    }
  }
}
