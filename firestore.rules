rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'crpmovie@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isMasterAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Functions
    function isValidNews(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.excerpt is string && data.excerpt.size() <= 600
        && data.category is string && data.category.size() <= 60
        && data.author is string && data.author.size() <= 100
        && data.date is string && data.date.size() <= 60;
    }

    function isValidGallery(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 500
        && data.category is string && data.category.size() <= 50
        && data.aspectRatio in ['landscape', 'square'];
    }

    function isValidActivity(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string && data.date.size() <= 60
        && data.location is string && data.location.size() <= 150
        && data.type is string && data.type.size() <= 60
        && data.status in ['Dijadwalkan', 'Sedang Berlangsung', 'Selesai'];
    }

    function isValidContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    // Collections

    // 1. News Articles
    match /news/{newsId} {
      allow get: if isValidId(newsId);
      allow list: if true;
      allow create: if isValidId(newsId) && isAdmin() && isValidNews(incoming());
      allow update: if isValidId(newsId) && isAdmin() && isValidNews(incoming());
      allow delete: if isValidId(newsId) && isAdmin();
    }

    // 2. Photo Galleries
    match /galleries/{galleryId} {
      allow get: if isValidId(galleryId);
      allow list: if true;
      allow create: if isValidId(galleryId) && isAdmin() && isValidGallery(incoming());
      allow update: if isValidId(galleryId) && isAdmin() && isValidGallery(incoming());
      allow delete: if isValidId(galleryId) && isAdmin();
    }

    // 3. SAR Activities & Exercises
    match /activities/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if true;
      allow create: if isValidId(activityId) && isAdmin() && isValidActivity(incoming());
      allow update: if isValidId(activityId) && isAdmin() && isValidActivity(incoming());
      allow delete: if isValidId(activityId) && isAdmin();
    }

    // 4. Contact & PPID Submissions
    match /contacts/{contactId} {
      allow create: if isValidId(contactId) && isValidContact(incoming());
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // 5. Admins
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isMasterAdmin());
      allow write: if isMasterAdmin();
    }
  }
}
