rules_version = '2';

// Firebase Storage rules for Kantor SAR Manado.
//
// Deploy with:  firebase deploy --only storage
// (or paste into Firebase Console -> Storage -> Rules)

service firebase.storage {
  match /b/{bucket}/o {

    // Default-deny everything not matched below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'crpmovie@gmail.com';
    }

    // NOTE: cross-service firestore.exists() can only read the (default)
    // database. This project's Firestore data lives in a named database
    // (see firestoreDatabaseId in firebase-applet-config.json), so this
    // lookup cannot see the real admins collection and will not grant
    // access. Uploads therefore work for the master admin only. To let
    // other admins upload, give them a custom auth claim and check
    // request.auth.token here instead.
    function isAdmin() {
      return isMasterAdmin();
    }

    // Uploaded images must be real images and bounded in size. This mirrors
    // MAX_IMAGE_BYTES in src/lib/firebase.ts.
    function isValidImage() {
      return request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Public site imagery: world-readable, admin-writable.
    match /galleries/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /news/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    match /activities/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
  }
}
